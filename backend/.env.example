# --- LLM (must be multimodal + tool calling) -----------------------------
# Leave MODEL empty to use the first provider that has a key.
MODEL=
# Google Gemini — FREE tier, no card: https://aistudio.google.com/apikey
GOOGLE_API_KEY=
# Free tier allows only a few requests per minute: keep this around 8 with Gemini free, 0 (unlimited) otherwise
MODEL_RPM=8
# Anthropic (MODEL=anthropic:claude-sonnet-4-6)
# ANTHROPIC_API_KEY=sk-ant-...
# or OpenAI / any OpenAI-compatible server (e.g. vLLM)
# MODEL=openai:gpt-4.1
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://.../v1
# Optional cheaper model for the sub-agents
# SUBAGENT_MODEL=anthropic:claude-haiku-4-5

# --- GPU server on Google Colab (T4) --------------------------------------
# Printed by colab/gpu_server.ipynb. Empty = placeholder SVG images, BM25-only skill search.
COLAB_GPU_URL=
COLAB_GPU_TOKEN=

# --- Misc -------------------------------------------------------------------
PORT=3000
AUTO_SUGGEST_SKILLS=4
RECURSION_LIMIT=400
# Extra browser origins allowed to call the API (comma-separated). The GitHub Pages UI
# and localhost are always allowed; add your own frontend origin if you host one.
CORS_ORIGINS=
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=...
