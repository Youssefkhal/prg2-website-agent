{
  "name": "website-deep-agent",
  "version": "1.0.0",
  "description": "Multi-agent / multimodal deep agent (LangChain deepagents + NestJS) that builds corporate websites with text and generated images. GPU work runs on Google Colab (T4).",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "dev": "tsc -p tsconfig.json && node --watch dist/main.js",
    "skills:demo": "node scripts/generate-demo-skills.mjs 1000",
    "test": "tsc -p tsconfig.json && node --test test/registry.test.js",
    "demo": "node dist/cli/demo.js"
  },
  "dependencies": {
    "@langchain/anthropic": "^1.5.13",
    "@langchain/core": "^1.3.2",
    "@langchain/langgraph": "^1.4.10",
    "@langchain/langgraph-checkpoint": "^1.1.5",
    "@langchain/langgraph-sdk": "^1.9.23",
    "@langchain/openai": "^1.6.3",
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "deepagents": "^1.16.2",
    "dotenv": "^16.4.7",
    "langchain": "^1.5.10",
    "langsmith": ">=0.7.1 <0.10.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=20"
  }
}
